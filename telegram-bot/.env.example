# Telegram
# Crie o bot com o @BotFather no Telegram e cole o token aqui
TELEGRAM_BOT_TOKEN=seu-token-do-botfather

# Claude AI (Anthropic)
# Gere a chave em https://console.anthropic.com
ANTHROPIC_API_KEY=sk-ant-...
CLAUDE_MODEL=claude-opus-5
SYSTEM_PROMPT=Voce e um assistente virtual simpatico e objetivo da FlashDrop. Responda sempre em portugues.

# Historico de conversa (quantidade de mensagens guardadas por chat)
HISTORY_LIMIT=20
